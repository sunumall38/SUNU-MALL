# Adresse de l'API Django (sans « / » final). Par défaut : l'API de production.
# Pour viser un backend local depuis un téléphone, mettre l'IP du PC sur le
# réseau Wi-Fi (ex. http://192.168.1.20:8000/api) : « localhost » désigne le
# téléphone lui-même.
EXPO_PUBLIC_API_URL=https://sunu-mall-api.onrender.com/api

# Site web, ouvert pour les espaces qui n'existent pas encore dans l'appli
# (commerçant, partenaire, admin), l'inscription et le mot de passe oublié.
EXPO_PUBLIC_SITE_URL=https://sunu-mall.pages.dev
