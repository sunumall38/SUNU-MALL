# =========================================================
# SUNU MALL — Variables d'environnement Backend (TEMPLATE)
# =========================================================

# Django
DEBUG=True
# Le code lit DJANGO_SECRET_KEY (pas SECRET_KEY) — ce nom doit être respecté
# pour que cette valeur soit réellement prise en compte. En prod, sans cette
# variable config.settings.prod refuse de démarrer (sécurité).
DJANGO_SECRET_KEY=remplacez-par-une-cle-aleatoire-longue-et-securisee
# Utilisé UNIQUEMENT par config.settings.prod (préfixe DJANGO_ obligatoire,
# la clé ALLOWED_HOSTS seule est ignorée par le code). Liste des domaines
# publics de la plateforme, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=api.sunumall.sn,www.sunumall.sn,healthcheck.railway.app
SECURE_SSL_REDIRECT=False
# Module de réglages. En production : config.settings.prod (sinon le serveur
# WSGI/Celery retombe sur dev -> DEBUG actif par défaut, à ne pas laisser).
DJANGO_SETTINGS_MODULE=config.settings.prod

# Base de données (doit correspondre à infra/env/postgres.env)
POSTGRES_DB=sunu_mall
POSTGRES_USER=sunu_mall
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-securise
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# MinIO / Stockage media
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=sunu-mall-media
# En PROD, DOMAINE PUBLIC du endpoint S3 exposé par le reverse proxy (ex:
# s3.sunumall.sn). Avec localhost, les URLs d'images produits générées sont
# inaccessibles depuis le navigateur. Le bucket est inclus automatiquement.
MINIO_PUBLIC_ENDPOINT=localhost:9010
# Force les URLs d'images en https quand le S3 passe par nginx/TLS.
MINIO_USE_SSL=False
# Railway Buckets : stockage privé, URLs temporaires signées et adressage
# virtual-hosted. Les valeurs locales ci-dessous conservent le mode MinIO.
S3_REGION_NAME=us-east-1
S3_ADDRESSING_STYLE=path
S3_QUERYSTRING_AUTH=False
S3_QUERYSTRING_EXPIRE=3600

# Identifiants S3 distincts pour le bucket KYC privé. Sans ces variables,
# les identifiants du stockage média sont réutilisés (compatibilité MinIO).
KYC_STORAGE_BUCKET=sunu-mall-private
KYC_S3_ACCESS_KEY=
KYC_S3_SECRET_KEY=
KYC_S3_ENDPOINT=
KYC_S3_REGION=us-east-1
KYC_S3_ADDRESSING_STYLE=path
KYC_STORAGE_AUTO_CREATE=True

# CORS : origines autorisées (frontend Vite, nginx)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3004,http://localhost:3010,http://localhost:3011,http://localhost:8081

# URL du frontend, utilisée pour construire les liens dans les emails
# (vérification d'email, notifications...). Doit correspondre au port
# réel du frontend Vite (voir frontend/vite.config.ts : server.port).
FRONTEND_URL=http://localhost:3004

# Clé API Anthropic (Claude) — génération de description produit + assistant
# client (apps/ia/). Générer la tienne sur console.anthropic.com.
ANTHROPIC_API_KEY=

# Recommandé sur Railway : API HTTPS Resend. SMTP est bloqué sur les offres
# Railway Free/Trial/Hobby. La clé doit avoir uniquement le droit d'envoi.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=SUNU MALL <noreply@votre-domaine.sn>

# Alternative SMTP (Railway Pro ou autre hébergeur).
# EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=15

# Paiement : mettre à True pour les tests sandbox, False en production
PAYMENT_SANDBOX=True

# Wave — API Business Checkout (business.wave.com/dev-portal). Une fois les
# clés renseignées ET PAYMENT_SANDBOX=False, les paiements Wave sont réels.
WAVE_API_KEY=
# Secret des webhooks Wave (portail développeur, WEBHOOKS) — vérifie la
# signature HMAC des notifications. Sans lui, les webhooks sont rejetés.
WAVE_WEBHOOK_SECRET=

# Orange Money — API Web Payment (developer.orange.com/apis/om-webpay).
# Jeton d'accès = OAuth2 client_credentials (client_id/client_secret) ;
# chaque paiement est ensuite signé par la merchant_key reçue à l'onboarding.
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
# Segment pays de l'endpoint de production ("sn" pour le Sénégal) ; le
# sandbox passe automatiquement par "/dev/".
ORANGE_MONEY_COUNTRY_PATH=sn
# Devise : XOF en production, parfois "OUV" dans certains environnements
# de test Orange.
ORANGE_MONEY_CURRENCY=XOF

# URL publiques utilisées par les passerelles : FRONTEND_URL pour les liens
# de retour du client, BACKEND_URL (l'API backend, PAS le frontend) pour la
# notif_url Orange Money / le webhook Wave. Doivent être accessibles en HTTPS.
FRONTEND_URL=
BACKEND_URL=
